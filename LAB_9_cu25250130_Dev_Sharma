def solve():
    N = int(input())
    A = list(map(int, input().split()))

    # Check whether all elements are equal
    for i in range(1, N):
        if A[i] != A[0]:
            print(-1)
            return

    print(abs(A[0]))


# Number of test cases
T = int(input())

for _ in range(T):
    solve()