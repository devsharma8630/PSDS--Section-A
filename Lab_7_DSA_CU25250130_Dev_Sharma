# 2.	Problem 2: Rearrange Array to Maximize Adjacent Sum Difference
'''
def maximize_difference(arr):
    arr.sort()

    n = len(arr)
    result = []

    # Take small and large elements alternately
    left = 0
    right = n - 1

    while left <= right:
        if left == right:
            result.append(arr[left])
        else:
            result.append(arr[left])
            result.append(arr[right])

        left += 1
        right -= 1

    # Try both possible arrangements
    a = result
    b = result[::-1]

    def calculate(x):
        return sum(abs(x[i] - x[i - 1]) for i in range(1, len(x)))

    if calculate(b) > calculate(a):
        result = b

    return result, calculate(result)


# Input
arr = list(map(int, input("Enter array elements: ").split()))

result, total = maximize_difference(arr)

print("Rearranged array:", result)
print("Maximum sum:", total)
